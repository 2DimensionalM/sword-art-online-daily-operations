{
  "name": "sword-art-online-daily-operations",
  "version": "0.1.0",
  "description": "A local-first mission planner with a retro JRPG-inspired interface and SQLite persistence.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-local-app.mjs dev",
    "dev:web": "vinext dev --port 1998",
    "db": "node scripts/local-db-server.mjs",
    "db:backup": "node scripts/backup-local-db.mjs",
    "recover:legacy": "node scripts/recover-legacy-storage.mjs",
    "build": "vinext build",
    "start": "node scripts/run-local-app.mjs start",
    "start:web": "vinext start --port 1998",
    "design:check": "node scripts/check-design-harness.mjs",
    "lint": "npm run design:check && eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node --experimental-strip-types --test scripts/test-*.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
